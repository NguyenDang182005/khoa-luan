@startuml
!include _style.iuml
|ADMIN|
start
:Gửi POST /employees;
|EmployeesService|
if (Trùng email hoặc mã?) then (có)
  :409 Conflict;
  stop
else (không)
endif
:Sinh mã EMP#### kế tiếp (số lớn nhất + 1);
partition "Transaction ($transaction)" {
  if (Có truyền role?) then (có)
    :Tạo User active (whitelist OAuth);
  else (không)
    :Tạo User giữ chỗ (isActive = false);
  endif
  :Tạo hồ sơ Employee trạng thái PROBATION
  (phòng ban, chức danh, quản lý) + Hợp đồng thử việc (nếu có baseSalary)
  + Gán toàn bộ OnboardingTask trạng thái PENDING;
}
|ADMIN|
:Xem hồ sơ nhân viên trên portal;
stop
@enduml
