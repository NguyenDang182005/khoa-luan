@startuml
!include _style.iuml
autonumber
hide footbox
actor "Nhân viên" as E
participant "employee-portal-view" as W
participant "SettingsService" as S
participant "AttendanceService" as A
database "PostgreSQL" as DB
W -> S : GET /settings/geofence
activate S
S --> W : lat, lng, radiusM
deactivate S
E -> W : Bấm Check-in
activate W
W -> W : navigator.geolocation\nvà công thức Haversine
alt Ngoài bán kính cho phép
  W --> E : Từ chối, hiển thị khoảng cách
else Trong bán kính
  W -> A : POST /attendance/check-in (lat, lng)
  activate A
  A -> DB : Đọc OfficeGeofence, tính lại Haversine
  A --> W : 403 nếu ngoài bán kính
  A -> DB : Xác định dayType theo bảng holidays
  A -> A : Ngày thường sau 08:30 là LATE,\nngược lại PRESENT
  A -> DB : Đã có check-in hôm nay?
  A --> W : 409 nếu đã check-in
  A -> DB : INSERT attendance (workDays = 0),\nhoặc UPDATE nếu đã có bản ghi
  A --> W : 201 Created
  deactivate A
end
deactivate W
E -> W : Bấm Check-out
activate W
W -> A : POST /attendance/check-out
activate A
alt Ngày thường
  A -> A : workDays = phút trong 2 ca (08:00–12:00\nvà 13:30–17:30) / 480 (tối đa 4 số lẻ)
  A -> A : overtime = giờ từ đơn OT đã duyệt\n(hoặc ca tối ngoài khung 08:00–17:30)
else Cuối tuần / ngày lễ
  A -> A : workDays = 0, toàn bộ giờ làm là overtime\n(trừ phần trùng khung nghỉ trưa 12:00–13:30)
end
A -> DB : UPDATE attendance
A --> W : 201 Created
deactivate A
deactivate W
@enduml
