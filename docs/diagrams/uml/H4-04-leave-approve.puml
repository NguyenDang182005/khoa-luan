@startuml
!include _style.iuml
skinparam maxMessageSize 320
autonumber
hide footbox
actor "Nhân viên" as E
actor "ADMIN" as AD
participant "LeaveService" as L
database "PostgreSQL" as DB
E -> L : POST /leave (loại đơn, ngày, lý do)
activate L
L -> L : countWorkdays (bỏ T7, CN, ngày lễ) + kiểm tra số dư phép năm theo từng năm
L -> DB : Kiểm tra trùng đơn PENDING / APPROVED (bỏ qua đơn OT và đơn đi muộn)
alt Trùng ngày hoặc vượt số dư
  L --> E : 400 Bad Request
else Hợp lệ
  L -> DB : Lưu đơn PENDING (đơn OT luôn có overtimeDate)
  L --> E : 201 Created
end
deactivate L
AD -> L : PATCH /leave/:id/approve
activate L
L -> DB : Kiểm tra đơn PENDING, hồ sơ người duyệt và kỳ lương chưa APPROVED/PAID
alt Kỳ lương đã chốt
  L --> AD : 400 Bad Request
else Kỳ lương còn mở — Transaction (FOR UPDATE theo nhân viên)
  L -> DB : Khóa bản ghi nhân viên, kiểm tra lại PENDING, không trùng APPROVED khác & đủ số dư
  alt Đơn đến muộn / về sớm
    L -> DB : Chấm công LATE → PRESENT (giữ nguyên giờ làm, số công)
  else Đơn nghỉ hoặc công tác (không phải OT)
    L -> DB : Chặn 400 nếu ngày đã chấm công; ngược lại upsert attendance ON_LEAVE
  end
  L -> DB : Cập nhật APPROVED, approvedBy, approvedAt & COMMIT
  L --> AD : 200 OK
end
deactivate L
@enduml
