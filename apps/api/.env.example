# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres123@127.0.0.1:5432/hr_system_db?schema=public"

# JWT
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here
JWT_REFRESH_EXPIRES_IN=30d

# Web URL (CORS)
WEB_URL=http://localhost:3000

# n8n Integration
N8N_API_KEY=your-n8n-api-key-here
N8N_URL=http://localhost:5678

# WebSocket
WS_CORS_ORIGINS=http://localhost:3000,http://localhost:19000,http://localhost:19006
