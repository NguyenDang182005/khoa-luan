        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sessionId: $json.sessionId, externalId: $json.userId, content: $json.answer }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "send-zalo",
      "name": "Send Reply Outbound",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "__N8N_HEADER_AUTH_ID__",
          "name": "NestJS API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.shouldEscalate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-escalate",
      "name": "Should Escalate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        460
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3001/api/v1/n8n/escalate",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sessionId: $(\"Parse CSKH Output\").first().json.sessionId, userId: $(\"Parse CSKH Output\").first().json.userId, channel: \"zalo\", lastMessage: $(\"Parse CSKH Output\").first().json.userMessage, reason: $(\"Parse CSKH Output\").first().json.escalateReason || \"AI phat hien vuot pham vi CSKH\" }) }}",
        "options": {}
      },
      "id": "escalate",
      "name": "Escalate to Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
