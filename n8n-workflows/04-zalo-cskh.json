{
  "name": "04 - Zalo OA CSKH Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "zalo-webhook",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "zalo-webhook",
      "name": "Zalo OA Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "zalo-cskh-webhook"
    },
    {
      "parameters": {},
      "id": "cskh-router-input",
      "name": "Input from Router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        240,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\n// Slack Events API (transport demo của kênh Zalo) — chỉ nhận DM từ người thật\nconst evt = body.event;\nif (evt && evt.type === \"message\" && evt.channel_type === \"im\" && evt.text && !evt.bot_id && evt.subtype === undefined) {\n  return [{ json: { userId: evt.user, message: evt.text, originalMessage: evt.text, channel: \"zalo\", externalId: evt.user } }];\n}\n// Zalo OA / payload test của WF01 Router\nconst userId = body.sender?.id || body.user_id || body.userId || body.employeeId || \"guest\";\nconst raw = body.message?.text || (typeof body.message === 'string' ? body.message : '') || body.originalMessage || body.maskedMessage || \"\";\nif (!raw) return [];\nconst masked = body.maskedMessage || raw;\nreturn [{ json: { userId, message: masked, originalMessage: raw, channel: body.channel || \"zalo\", externalId: userId } }];"
      },
      "id": "parse-zalo",
      "name": "Parse Zalo Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3001/api/v1/n8n/chat/session",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: \"CSKH\", channel: \"zalo\", externalId: $json.userId }) }}",
        "options": {}
      },
      "id": "get-session",
      "name": "Get/Create CSKH Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__N8N_HEADER_AUTH_ID__",
          "name": "NestJS API Key"
        }
      }
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3001/api/v1/n8n/chat/message",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sessionId: $json.id, role: \"user\", content: $(\"Parse Zalo Message\").first().json.originalMessage, metadata: { channel: \"zalo\", maskedMessage: $(\"Parse Zalo Message\").first().json.message, userId: $(\"Parse Zalo Message\").first().json.userId } }) }}",
        "options": {}
      },
      "id": "save-user-msg",
      "name": "Save User Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "__N8N_HEADER_AUTH_ID__",
          "name": "NestJS API Key"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $(\"Parse Zalo Message\").first().json.message }}",
        "systemMessage": "Ban la nhan vien CSKH chuyen nghiep cua cong ty. Tra loi NGAN GON (toi da 200 tu), than thien, lich su, bang tieng Viet.\nNeu gap tinh huong VUOT PHAM VI CSKH thong thuong (khieu nai nghiem trong, yeu cau boi thuong lon, loi he thong nghiem trong, yeu cau gap lanh dao, van de phap ly), PHAI ket thuc cau tra loi bang:\n[CAN_ESCALATE: mo ta ngan gon ly do can leo thang]\nKhong duoc tu y giai quyet cac van de vuot pham vi — chuyen sang bo phan co tham quyen.",
        "options": {
          "maxIterations": 3,
          "systemMessage": "Ban la nhan vien CSKH chuyen nghiep cua cong ty. Tra loi NGAN GON (toi da 200 tu), than thien, lich su, bang tieng Viet.\nNeu gap tinh huong VUOT PHAM VI CSKH thong thuong (khieu nai nghiem trong, yeu cau boi thuong lon, loi he thong nghiem trong, yeu cau gap lanh dao, van de phap ly), PHAI ket thuc cau tra loi bang:\n[CAN_ESCALATE: mo ta ngan gon ly do can leo thang]\nKhong duoc tu y giai quyet cac van de vuot pham vi — chuyen sang bo phan co tham quyen."
        }
      },
      "id": "cskh-agent",
      "name": "CSKH Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.5,
          "maxOutputTokens": 1024
        }
      },
      "id": "gemini-cskh",
      "name": "Gemini Flash",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        900,
        520
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "gemini-api-key",
          "name": "Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "sessionKey": "={{ $(\"Get/Create CSKH Session\").first().json.id }}",
        "tableName": "n8n_chat_histories",
        "contextWindowLength": 20
      },
      "id": "postgres-memory",
      "name": "Postgres Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1,
      "position": [
        1100,
        520
      ],
      "credentials": {
        "postgres": {
          "id": "postgres-db",
          "name": "HR System PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.output || \"\";\nconst session = $(\"Get/Create CSKH Session\").first().json;\nconst userId = $(\"Parse Zalo Message\").first().json.userId;\nconst userMsg = $(\"Parse Zalo Message\").first().json.originalMessage;\nconst escalateMatch = output.match(/\\[CAN_ESCALATE:\\s*([^\\]]+)\\]/);\nconst shouldEscalate = !!escalateMatch;\nconst escalateReason = escalateMatch ? escalateMatch[1].trim() : null;\nconst answer = output.replace(/\\[CAN_ESCALATE:[^\\]]*\\]/, '').trim() || \"Xin loi, vui long thu lai sau.\";\nreturn [{ json: { answer, shouldEscalate, escalateReason, sessionId: session.id, userId, userMessage: userMsg } }];"
      },
      "id": "parse-output",
      "name": "Parse CSKH Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3001/api/v1/n8n/chat/message",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sessionId: $json.sessionId, role: \"assistant\", content: $json.answer, metadata: { model: \"gemini-2.5-flash\", escalated: $json.shouldEscalate, escalateReason: $json.escalateReason } }) }}",
        "options": {}
      },
      "id": "save-assistant",
