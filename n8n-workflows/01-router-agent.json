{
  "name": "01 - Router Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook /chat",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "chat-router-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body=$input.first().json.body||{};const text=body.message||\"\";const channel=body.channel||\"web\";const employeeId=body.employeeId||null;const scenarioType=body.scenarioType||null;const masked=text.replace(/\\b(\\d{9}|\\d{12})\\b/g,\"[MASKED_ID]\").replace(/\\b(0[35789]\\d{8})\\b/g,\"[MASKED_PHONE]\").replace(/[\\w.-]+@[\\w.-]+\\.\\w+/g,\"[MASKED_EMAIL]\");return[{json:{originalMessage:text,maskedMessage:masked,channel,employeeId,scenarioType}}];"
      },
      "id": "pii-masking",
      "name": "PII Masking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ \"Hay phan loai cau hoi sau vao mot trong cac nhan: HR_QA, TRAINING, CSKH, OTHER.\\nCau hoi: \" + $json.maskedMessage + \"\\nTra ve duy nhat ten nhan, vi du: HR_QA\" }}",
        "systemMessage": "Ban la bo phan loai intent AI. Nhiem vu: tra ve dung mot ma intent trong cac ma sau: HR_QA (hoi ve nhan su, luong, nghi phep, hop dong, BHXH, luat lao dong), TRAINING (luyen tap giao tiep, role-play), CSKH (khieu nai, cham soc khach hang), OTHER. Tuyet doi khong tra loi cau hoi, chi xuat ten ma intent.",
        "options": {
          "maxIterations": 1,
          "systemMessage": "Ban la bo phan loai intent AI. Nhiem vu: tra ve dung mot ma intent trong cac ma sau: HR_QA (hoi ve nhan su, luong, nghi phep, hop dong, BHXH, luat lao dong), TRAINING (luyen tap giao tiep, role-play), CSKH (khieu nai, cham soc khach hang), OTHER. Tuyet doi khong tra loi cau hoi, chi xuat ten ma intent."
        }
      },
      "id": "intent-agent",
      "name": "Intent Classifier",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0,
          "maxOutputTokens": 1024
        }
      },
      "id": "gemini-router",
      "name": "Gemini Flash",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        480,
        520
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "gemini-api-key",
          "name": "Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.output || \"\").trim().toUpperCase();\nlet intent = \"OTHER\";\nif (raw.includes(\"HR_QA\")) intent = \"HR_QA\";\nelse if (raw.includes(\"TRAINING\")) intent = \"TRAINING\";\nelse if (raw.includes(\"CSKH\")) intent = \"CSKH\";\nelse {\n  const msg = (($(\"PII Masking\").first().json.maskedMessage || \"\")).toLowerCase();\n  if (/lương|phép|nghỉ|hợp đồng|bhxh|bhyt|chấm công/i.test(msg)) intent = \"HR_QA\";\n  else if (/training|đào tạo|role-play|kịch bản/i.test(msg)) intent = \"TRAINING\";\n  else if (/khiếu nại|khách hàng|sản phẩm|cskh/i.test(msg)) intent = \"CSKH\";\n}\nconst prev = $(\"PII Masking\").first().json;\nreturn [{ json: { ...prev, intent } }];"
      },
      "id": "parse-intent",
      "name": "Parse Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "HR_QA",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "HR_QA"
            },
            {
              "conditions": {
                "options": {
