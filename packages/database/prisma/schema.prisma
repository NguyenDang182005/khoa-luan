// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// ENUMS
// =====================

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  PROBATION
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  EMERGENCY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  REMOTE
  ON_LEAVE
}

enum ContractType {
  FULL_TIME
  PART_TIME
  PROBATION
  FREELANCE
  INTERNSHIP
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum ChatSessionType {
  HR_QA
  CSKH
  TRAINING
}

enum NotificationType {
  PAYROLL
  LEAVE
  ATTENDANCE
  ONBOARDING
  SYSTEM
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum AttendanceDayType {
  NORMAL
  WEEKEND
  HOLIDAY
}

enum TrainingScenario {
  CUSTOMER_COMPLAINT
  COLLEAGUE_CONFLICT
  MANAGER_FEEDBACK
  NEW_EMPLOYEE_ONBOARDING
  PERFORMANCE_REVIEW
  GENERAL_COMMUNICATION
}

enum TrainingAttemptStatus {
  IN_PROGRESS
  COMPLETED
  GRADED
}

// =====================
// MODELS
// =====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  role         UserRole @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Firebase / OAuth fields
  firebaseUid  String?  @unique
  googleId     String?  @unique
  facebookId   String?  @unique
  avatarUrl    String?
  displayName  String?

  // Security (cấu hình từ trang Cài Đặt > Bảo mật)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?

  employee          Employee?
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  loginHistory      LoginHistory[]
  settingsAuditLogs SettingsAuditLog[] @relation("SettingsAuditLogs")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String? // Địa chỉ IP của phiên đăng nhập
  userAgent String? // Thiết bị / trình duyệt của phiên đăng nhập

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Department {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?
  managerId   String?
  parentId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager   Employee?    @relation("DepartmentManager", fields: [managerId], references: [id])
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")
  employees Employee[]   @relation("EmployeeDepartment")
  positions Position[]

  @@map("departments")
}

model Position {
  id           String  @id @default(cuid())
  title        String
  code         String  @unique
  level        Int     @default(1)
  departmentId String
  minSalary    Float?
  maxSalary    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@map("positions")
}

model Employee {
  id           String           @id @default(cuid())
  employeeCode String           @unique
  userId       String           @unique
  fullName     String
  email        String           @unique
  phone        String?
  gender       Gender?
  dateOfBirth  DateTime?
  address      String?
  avatarUrl    String?
  nationalId   String?          @unique
  joinDate     DateTime
  status       EmploymentStatus @default(PROBATION)
  departmentId String
  positionId   String
  managerId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      Department     @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  position        Position       @relation(fields: [positionId], references: [id])
  manager         Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates    Employee[]     @relation("EmployeeManager")
  managedDepts    Department[]   @relation("DepartmentManager")
  attendances         Attendance[]
  leaveRequests       LeaveRequest[]       @relation("EmployeeLeave")
  approvedLeaves      LeaveRequest[]       @relation("ApproverLeave")
  contracts           Contract[]
  payrolls            Payroll[]
  onboardingProgress  OnboardingProgress[]
  chatSessions        AiChatSession[]
  trainingSessions    TrainingSession[]

  @@map("employees")
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus @default(PRESENT)
  workHours  Float?
  overtime   Float?
  note       String?
  location   String?
  dayType    AttendanceDayType @default(NORMAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendances")
}

model LeaveRequest {
  id              String      @id @default(cuid())
  employeeId      String
  type            LeaveType
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  totalDays       Float
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee  @relation("EmployeeLeave", fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy Employee? @relation("ApproverLeave", fields: [approvedById], references: [id])

  @@map("leave_requests")
}

model Contract {
  id             String       @id @default(cuid())
  employeeId     String
  contractNumber String       @unique
  type           ContractType
  startDate      DateTime     @db.Date
  endDate        DateTime?    @db.Date
  baseSalary     Float
  allowances     Float        @default(0)
  signedDate     DateTime     @db.Date
  isActive       Boolean      @default(true)
  fileUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model Payroll {
  id                String        @id @default(cuid())
  employeeId        String
  month             Int
  year              Int
  baseSalary        Float
  allowances        Float         @default(0)
  bonus             Float         @default(0)
  deductions        Float         @default(0)
  tax               Float         @default(0)
  netSalary         Float
  workingDays       Int
  actualWorkingDays Int
  overtimeHours     Float         @default(0)
  overtimePay       Float         @default(0)
  status            PayrollStatus @default(DRAFT)
  paidAt            DateTime?
  note              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@map("payrolls")
}

model SalaryConfig {
  id            String   @id @default(cuid())
  year          Int      @unique
  bhxhRate      Float    @default(0.08)   // 8% BHXH nhân viên
  bhytRate      Float    @default(0.015)  // 1.5% BHYT nhân viên
  bhtnRate      Float    @default(0.01)   // 1% BHTN nhân viên
  pitFreeAmount Float    @default(11000000) // Mức giảm trừ gia cảnh (11tr)
  overtimeRate  Float    @default(1.5)    // Hệ số OT ngày thường
  otWeekendRate Float    @default(2.0)    // Hệ số OT cuối tuần
  otHolidayRate Float    @default(3.0)    // Hệ số OT ngày lễ
  standardWorkHours Float @default(8)     // Số giờ làm tiêu chuẩn/ngày

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("salary_configs")
}

/// Vùng địa lý chấm công (bản ghi đơn "default") — cấu hình từ trang Cài Đặt
model OfficeGeofence {
  id      String @id @default("default")
  name    String @default("Văn phòng công ty")
  lat     Float  @default(10.7951)
  lng     Float  @default(106.7218)
  radiusM Float  @default(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("office_geofences")
}

model OnboardingTask {
  id          String  @id @default(cuid())
  title       String
  description String?
  category    String  // e.g. "paperwork", "equipment", "training", "introduction"
  dueAfterDays Int    @default(7) // Deadline: N ngày sau ngày vào
  isRequired  Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progresses OnboardingProgress[]

  @@map("onboarding_tasks")
}

model OnboardingProgress {
  id         String               @id @default(cuid())
  employeeId String
  taskId     String
  status     OnboardingTaskStatus @default(PENDING)
  completedAt DateTime?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task     OnboardingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([employeeId, taskId])
  @@map("onboarding_progress")
}

model TrainingQuestion {
  id           String           @id @default(cuid())
  scenario     TrainingScenario
  type         String           // "quiz" | "scenario"
  order        Int              @default(0)
  question     String           @db.Text
  optionA      String?
  optionB      String?
  optionC      String?
  optionD      String?
  correctAnswer String?         // "A" | "B" | "C" | "D" for quiz
  explanation  String?          @db.Text
  isActive     Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("training_questions")
}

model TrainingSession {
  id           String                @id @default(cuid())
  employeeId   String
  scenario     TrainingScenario
  status       TrainingAttemptStatus @default(IN_PROGRESS)
  quizScore    Float                 @default(0)
  aiScore      Json?                 // { professional, empathy, problemSolving, clarity }
  totalScore   Float                 @default(0)
  aiFeedback   String?               @db.Text
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attempts TrainingAttempt[]

  @@map("training_sessions")
}

model TrainingAttempt {
  id          String  @id @default(cuid())
  sessionId   String
  questionId  String
  answer      String  @db.Text
  isCorrect   Boolean?
  aiEvaluation Json?  // { professional, empathy, problemSolving, clarity, feedback }

  createdAt DateTime @default(now())

  session  TrainingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("training_attempts")
}

model AiChatSession {
  id         String          @id @default(cuid())
  employeeId String?
  type       ChatSessionType
  channel    String          @default("web") // "web" | "mobile" | "zalo"
  externalId String?         // Zalo userId hoặc mobile deviceId
  isActive   Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  messages AiChatMessage[]

  @@map("ai_chat_sessions")
}

model AiChatMessage {
  id        String  @id @default(cuid())
  sessionId String
  role      String  // "user" | "assistant"
  content   String  @db.Text
  metadata  Json?   // intent, score, maskedMessage, escalated, escalateReason, model, etc.

  createdAt DateTime @default(now())

  session AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("ai_chat_messages")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  data       Json?            // Extra payload
  isRead     Boolean          @default(false)
  readAt     DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// =====================
// SETTINGS MODELS (trang Cài Đặt Hệ Thống)
// =====================

/// Chính sách phép năm (bản ghi đơn "default") — cấu hình từ trang Cài Đặt > Phép Năm
model LeavePolicy {
  id String @id @default("default")

  annualQuotaDays          Float   @default(12)   // Số ngày phép chuẩn/năm
  seniorityBonusEveryYears Int     @default(5)    // Cộng thêm mỗi N năm thâm niên (0 = tắt)
  seniorityBonusDays       Float   @default(1)    // Số ngày cộng tại mỗi mốc thâm niên
  prorateByJoinMonth       Boolean @default(true) // Tính tỷ lệ theo tháng vào làm năm đầu
  maxCarryOverDays         Float   @default(0)    // Chuyển tối đa X ngày chưa dùng sang năm sau (0 = không)
  note                     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leave_policies")
}

/// Chính sách bảo mật (bản ghi đơn "default") — cấu hình từ trang Cài Đặt > Bảo Mật
model SecurityPolicy {
  id String @id @default("default")

  passwordMinLength   Int     @default(8)
  requireUppercase    Boolean @default(true)
  requireLowercase    Boolean @default(true)
  requireDigit        Boolean @default(true)
  requireSpecial      Boolean @default(true)
  passwordMaxAgeDays  Int     @default(0)   // 0 = không bắt buộc đổi định kỳ
  maxFailedAttempts   Int     @default(5)   // Khóa tài khoản sau N lần sai liên tiếp
  lockoutMinutes      Int     @default(15)  // Thời gian khóa tạm
  accessTokenTtlHours Int     @default(720) // Thời hạn access token (30 ngày)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("security_policies")
}

/// Cấu hình AI Agent phía NestJS (bản ghi đơn "default") — tham số model nằm trong n8n workflow
model AiAgentConfig {
  id String @id @default("default")

  enabled    Boolean @default(true)
  webhookUrl String? // Trống = dùng env N8N_WEBHOOK_URL
  apiKey     String? // Trống = dùng env N8N_API_KEY (write-only, không trả về client)
  timeoutMs  Int     @default(90000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_agent_configs")
}

/// Lịch sử đăng nhập (cả thành công lẫn thất bại) — xem từ trang Cài Đặt > Bảo Mật
model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  email     String // Email attempted — kể cả khi user không tồn tại
  success   Boolean
  reason    String? // USER_NOT_FOUND | ACCOUNT_DISABLED | ACCOUNT_LOCKED | INVALID_PASSWORD ...
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("login_history")
}

/// Nhật ký thay đổi cài đặt (append-only) — ai sửa gì, giá trị cũ -> mới
model SettingsAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  adminEmail  String
  section     String // leave_policy | security_policy | ai_agent | salary_config | geofence
  field       String
  oldValue    String?
  newValue    String?

  createdAt DateTime @default(now())

  admin User? @relation("SettingsAuditLogs", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@map("settings_audit_logs")
}
