{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "lib": ["ES2021"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2021"
  }
}
